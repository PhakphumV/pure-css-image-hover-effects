{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PhakphumV/pure-css-image-hover-effects/schemas/meta.schema.json",
  "title": "Effect metadata",
  "description": "Schema for the meta.json file in every effect directory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "title",
    "category",
    "description",
    "tags",
    "complexity",
    "css_features",
    "js_required",
    "extra_markup",
    "reduced_motion"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
      "description": "Lowercase, hyphenated. Must match the directory slug."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "category": {
      "type": "string",
      "enum": [
        "zoom",
        "pan",
        "rotate",
        "3d",
        "filter",
        "reveal",
        "fade",
        "shadow",
        "light",
        "border",
        "distortion",
        "overlay",
        "composite"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "complexity": {
      "type": "string",
      "enum": ["simple", "advanced"]
    },
    "css_features": {
      "type": "array",
      "items": { "type": "string" }
    },
    "js_required": {
      "type": "const",
      "const": false,
      "description": "Contract §1: pure CSS only."
    },
    "extra_markup": {
      "type": "const",
      "const": false,
      "description": "Contract §2: class on <div>, no extra wrappers."
    },
    "reduced_motion": {
      "type": "string",
      "enum": ["disabled", "instant", "no-change"],
      "description": "Behavior under prefers-reduced-motion: reduce."
    }
  }
}
